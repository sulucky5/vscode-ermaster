{
  "name": "ermaster-vscode",
  "displayName": "ERMaster for VS Code",
  "description": "A modern ER Diagram editor for VS Code compatible with Eclipse ERMaster (.erm)",
  "version": "1.0.3",
  "publisher": "sulucky5",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sulucky5/vscode-ermaster.git"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ermaster",
          "title": "ERMaster",
          "icon": "media/ermaster.svg"
        }
      ]
    },
    "views": {
      "ermaster": [
        {
          "type": "webview",
          "id": "ermaster.paletteView",
          "name": "%views.tools%"
        },
        {
          "type": "webview",
          "id": "ermaster.viewView",
          "name": "%views.view%"
        },
        {
          "type": "webview",
          "id": "ermaster.outlineView",
          "name": "%views.outline%"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "ermaster.editor",
        "displayName": "%editor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.erm"
          },
          {
            "filenamePattern": "*.erd"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "ermaster.newDiagram",
        "title": "%command.newDiagram.title%",
        "category": "ERMaster"
      }
    ],
    "configuration": {
      "title": "ERMaster",
      "properties": {
        "ermaster.language": {
          "type": "string",
          "enum": [
            "auto",
            "ko",
            "en",
            "ja"
          ],
          "default": "auto",
          "description": "%config.language.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "cd webview && npm run build",
    "build:extension": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "build:jdbc": "javac -encoding UTF-8 -cp lib/poi-3.7-20101029.jar -d dist/jdbc jdbc/JdbcReverseEngineer.java jdbc/ExcelTemplateExporter.java",
    "build": "npm run build:webview && npm run build:extension && npm run build:jdbc",
    "dev:webview": "cd webview && npm run dev",
    "publish:ovsx": "node scripts/publish.mjs ovsx",
    "publish:vscode": "node scripts/publish.mjs vscode",
    "publish:all": "node scripts/publish.mjs all",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "fast-xml-parser": "^4.3.4"
  }
}
