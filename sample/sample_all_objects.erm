			<physical_name>v_order_summary</physical_name>
			<logical_name>주문 요약 뷰</logical_name>
			<description>주문별 회원명 및 품목 수를 집계하는 조회 전용 뷰</description>
			<sql>SELECT o.order_id, o.order_no, u.user_name, COUNT(oi.order_item_id) AS item_count, o.total_amount, o.ordered_at
FROM public.orders o
JOIN public.users u ON u.user_id = o.user_id
LEFT JOIN public.order_items oi ON oi.order_id = o.order_id
GROUP BY o.order_id, o.order_no, u.user_name, o.total_amount, o.ordered_at</sql>
			<columns>
				<normal_column>
					<word_id>w_order_id</word_id>
					<id>col_vos_order_id</id>
