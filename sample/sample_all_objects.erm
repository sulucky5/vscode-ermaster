	<trigger_set>
		<trigger>
			<name>trg_orders_updated_at</name>
			<schema>public</schema>
			<sql>CREATE TRIGGER trg_orders_updated_at
BEFORE UPDATE ON public.orders
FOR EACH ROW
EXECUTE FUNCTION public.fn_set_updated_at();</sql>
			<description>주문 레코드 수정 시 updated_at 컬럼을 현재 시각으로 자동 갱신</description>
		</trigger>
	</trigger_set>
