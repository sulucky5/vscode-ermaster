# Copy this file to .env.publish and fill in your tokens.
# .env.publish is excluded from Git (.gitignore) and VSIX packages (.vscodeignore).

# Open VSX Registry Access Token (https://open-vsx.org/user-settings/tokens)
OVSX_PAT=

# VS Code Marketplace Personal Access Token (optional, Azure DevOps)
VSCE_PAT=
